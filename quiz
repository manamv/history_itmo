<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Квиз · Как Ремесленное училище стало университетом</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500;600&display=swap">
<style>
:root{
  --ink:#f4f6ff;--mute:rgba(236,240,255,.7);--wash:rgba(6,12,40,.62);
  --glass:rgba(255,255,255,.1);--glass2:rgba(255,255,255,.2);--edge:rgba(255,255,255,.32);
  --lens:#4f7bff;--brass:#f0c77a;--ok:#62e8b4;--bad:#ff8791;
  --font:"Geologica",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  color-scheme:dark;box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){
  --ink:#0b1236;--mute:rgba(11,18,54,.68);--wash:rgba(236,241,255,.6);
  --glass:rgba(255,255,255,.5);--glass2:rgba(255,255,255,.75);--edge:rgba(255,255,255,.85);
  --lens:#2347d9;--brass:#8a5a00;--ok:#067a52;--bad:#c4263a;color-scheme:light}}
:root[data-theme="light"]{--ink:#0b1236;--mute:rgba(11,18,54,.68);--wash:rgba(236,241,255,.6);--glass:rgba(255,255,255,.5);--glass2:rgba(255,255,255,.75);--edge:rgba(255,255,255,.85);--lens:#2347d9;--brass:#8a5a00;--ok:#067a52;--bad:#c4263a;color-scheme:light}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:var(--font);color:var(--ink);background:#060b26;overflow-x:hidden;-webkit-font-smoothing:antialiased}

/* фон: кадр текущего вопроса, размытый и затонированный — стеклу есть что преломлять */
.bg{position:fixed;inset:-6%;background-size:cover;background-position:center;filter:blur(34px) saturate(1.5);transform:scale(1.1);opacity:0;transition:opacity 1.1s ease;z-index:0}
.bg.on{opacity:1}
.wash{position:fixed;inset:0;z-index:1;background:linear-gradient(160deg,var(--wash),rgba(10,24,90,.35) 55%,var(--wash))}

.stage{position:relative;z-index:2;min-height:100svh;max-width:1160px;margin:0 auto;padding:28px 20px;
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:28px;align-items:center}
.sheet{
  border-radius:30px;padding:34px 34px 30px;position:relative;
  background:linear-gradient(155deg,var(--glass2),var(--glass) 45%,rgba(255,255,255,.04));
  border:1px solid var(--edge);
  -webkit-backdrop-filter:blur(30px) saturate(190%);backdrop-filter:blur(30px) saturate(190%);
  box-shadow:inset 0 1.5px 0 rgba(255,255,255,.55),inset 0 -1px 0 rgba(255,255,255,.12),0 30px 80px rgba(2,6,32,.45);
}
.steps{display:flex;gap:6px;margin-bottom:26px}
.steps i{flex:1;height:3px;border-radius:3px;background:rgba(255,255,255,.22);overflow:hidden;position:relative}
.steps i::after{content:"";position:absolute;inset:0;background:var(--brass);transform:scaleX(0);transform-origin:left;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.steps i.done::after{transform:none}
.kind{font-size:14px;color:var(--mute);margin:0 0 10px}
h1,h2{font-weight:500;letter-spacing:-.015em;margin:0}
h1{font-size:clamp(32px,4.6vw,52px);line-height:1.08;margin-bottom:18px}
h2{font-size:clamp(22px,2.6vw,29px);line-height:1.27;margin-bottom:24px}
.lead{font-size:17px;line-height:1.55;color:var(--mute);margin:0 0 28px;max-width:46ch}

.opts{display:grid;gap:10px;margin:0;padding:0;list-style:none}
.opt{
  --mx:50%;--my:50%;width:100%;text-align:left;font:inherit;font-size:17px;color:var(--ink);cursor:pointer;
  display:flex;align-items:center;gap:14px;padding:15px 18px;border-radius:14px;
  background:radial-gradient(180px 90px at var(--mx) var(--my),rgba(255,255,255,.26),transparent 70%),var(--glass);
  border:1px solid var(--edge);transition:border-color .2s,background-color .2s,opacity .3s;
}
.opt::before{content:"";flex:none;width:18px;height:18px;border-radius:50%;border:1.5px solid var(--mute);transition:.25s}
.opt:hover:not(:disabled){border-color:var(--ink)}
.opt:disabled{cursor:default}
.opt.ok{border-color:var(--ok);background:rgba(98,232,180,.2)}
.opt.ok::before{border-color:var(--ok);background:var(--ok);box-shadow:0 0 0 4px rgba(98,232,180,.25)}
.opt.bad{border-color:var(--bad);background:rgba(255,135,145,.18)}
.opt.bad::before{border-color:var(--bad);background:var(--bad)}
.opt.dim{opacity:.45}
:focus-visible{outline:2px solid var(--brass);outline-offset:3px}

.why{margin-top:22px;font-size:15.5px;line-height:1.6;color:var(--mute);max-width:60ch}
.why strong{display:block;font-weight:600;font-size:17px;margin-bottom:6px;color:var(--ink)}
.why.good strong{color:var(--ok)}.why.nope strong{color:var(--bad)}
.row{display:flex;justify-content:flex-end;margin-top:22px;min-height:50px}
.btn{font:inherit;font-weight:500;font-size:16px;color:#fff;cursor:pointer;border:1px solid rgba(255,255,255,.5);border-radius:999px;padding:14px 28px;
  background:linear-gradient(160deg,rgba(120,150,255,.9),rgba(40,80,230,.9));box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 12px 30px rgba(20,50,200,.45);transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-1px);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 16px 38px rgba(20,50,200,.6)}
.btn:active{transform:scale(.98)}

/* фотопластина: матовое стекло снимается при ответе */
.plate{position:relative;border-radius:14px;overflow:hidden;aspect-ratio:5/4;border:1px solid var(--edge);box-shadow:0 30px 80px rgba(2,6,32,.55);background:#0a1030}
.plate img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}
.plate .veil{position:absolute;inset:0;display:grid;place-items:center;font-size:96px;font-weight:300;color:rgba(255,255,255,.75);
  -webkit-backdrop-filter:blur(30px) saturate(1.3) brightness(1.1);backdrop-filter:blur(30px) saturate(1.3) brightness(1.1);
  background:linear-gradient(135deg,rgba(255,255,255,.28),rgba(255,255,255,.08));transition:opacity 1s ease .1s}
.plate.veiled img{transform:scale(1.08)}
.plate.clear .veil{opacity:0;pointer-events:none}
.plate.clear img{transform:none}
.plate figcaption{position:absolute;left:0;right:0;bottom:0;padding:44px 20px 16px;font-size:14px;line-height:1.45;color:#fff;
  background:linear-gradient(transparent,rgba(4,8,30,.82));opacity:0;transform:translateY(8px);transition:.7s ease .35s}
.plate.clear figcaption{opacity:1;transform:none}
.plate.live figcaption{opacity:0}

.score{font-size:clamp(64px,10vw,104px);font-weight:300;line-height:1;letter-spacing:-.04em;margin:4px 0 10px}
.score small{font-size:.3em;letter-spacing:0;color:var(--mute);margin-left:10px;font-weight:400}
.strip{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:6px 0 26px}
.strip figure{margin:0}
.strip div{aspect-ratio:1;border-radius:10px;overflow:hidden;position:relative;border:2px solid var(--bad)}
.strip .y div{border-color:var(--ok)}
.strip img{width:100%;height:100%;object-fit:cover;display:block}
.strip figcaption{font-size:12px;line-height:1.3;color:var(--mute);margin-top:6px}
.hide{display:none!important}
@media (max-width:860px){
  .stage{grid-template-columns:1fr;padding:16px;gap:16px;align-items:start}
  .plate{order:-1;aspect-ratio:16/10}
  .sheet{padding:24px 22px}
}
.plate.reset,.plate.reset *{transition:none!important}
.sheet.fresh{animation:soft .4s ease both}
@keyframes soft{from{opacity:0}}
.opt.bad{animation:nope .42s ease}
@keyframes nope{20%{transform:translateX(-7px)}45%{transform:translateX(6px)}70%{transform:translateX(-3px)}}
.tip{font-size:13px;color:var(--mute);margin:18px 0 0}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="bg on" id="bgA"></div><div class="bg" id="bgB"></div><div class="wash"></div>
<main class="stage" id="stage">
  <section class="sheet" id="sheet" aria-live="polite"></section>
  <figure class="plate live" id="plate" style="margin:0"><img id="pimg" alt=""><div class="veil hide" id="veil" aria-hidden="true">?</div><figcaption id="pcap"></figcaption></figure>
</main>
<script>
var IM={uch:"data:image/jpeg;base64,",vav:"data:image/jpeg;base64,",cher:"data:image/jpeg;base64,",den:"data:image/jpeg;base64,",run:"data:image/jpeg;base64,",lit:"data:image/jpeg;base64,"};
var Q=[
 {kind:"Вопрос об учёном",img:"vav",pos:"50% 20%",veil:1,
  q:"Кто из учёных, о которых шла речь в лекции, был Президентом АН СССР в 1945–1951 годах и инициировал создание Инженерно-физического факультета в ЛИТМО?",
  o:["Ю.Н. Денисюк","С.И. Зилитинкевич","С.И. Вавилов","В.Н. Чуриловский"],a:2,
  cap:"С.И. Вавилов — советский физик, основатель научной школы оптики в СССР",
  e:"Сергей Иванович Вавилов — советский физик, основатель научной школы оптики в СССР. В 1945–1951 годах он возглавлял Академию наук СССР и выступил инициатором создания ИФФ в ЛИТМО. На факультете открылись кафедры физической оптики и спектроскопии, теоретической физики и электроники, рентгенографии и электрографии, теплодинамики и гидравлики."},
 {kind:"Вопрос по фотографии",img:"cher",pos:"50% 50%",
  q:"На фотографии — сотрудники института в 1940-х годах. В какой город эвакуировали ЛИТМО в годы войны?",
  o:["Черепаново","Новосибирск","Кисловодск","Томск"],a:0,
  cap:"Сотрудники института в Черепаново. Фото 1940-х годов",
  e:"Институт эвакуировали сначала на Кавказ, а затем в Новосибирскую область, в город Черепаново. Занятия и выпуск инженеров продолжались даже в военные годы. Сотрудники, оставшиеся в блокадном Ленинграде, превратили учебные мастерские в военно-ремонтную базу."},
 {kind:"Вопрос об учёном",img:"den",pos:"50% 40%",veil:1,
  q:"Кто в 1970 году получил Ленинскую премию и был избран членом-корреспондентом АН СССР за работы по оптической голографии?",
  o:["Феодосий Галкин","Ю.Н. Денисюк","Н.Б. Завадский","С.А. Шиканов"],a:1,
  cap:"Ю.Н. Денисюк с собственным голографическим портретом",
  e:"Ю.Н. Денисюк в 1970 году стал лауреатом Ленинской премии и членом-корреспондентом АН СССР. Его голографический метод получил международное признание. На слайде лекции учёный держит собственный голографический портрет."},
 {kind:"Вопрос по фотографии",img:"run",pos:"30% 50%",
  q:"На фотографии — спутниковая тарелка RUNNet на Кронверкском проспекте. В каком году институт стал инициатором и основным разработчиком этой сети?",
  o:["1992","1994","2009","2011"],a:1,
  cap:"Спутниковая тарелка RUNNet Университета ИТМО на Кронверкском проспекте",
  e:"В 1994 году институт стал инициатором и основным разработчиком сети RUNNet. В том же году ему присвоили статус университета и открыли факультет компьютерных технологий и управления. Двумя годами раньше, в 1992-м, ЛИТМО переименовали в Санкт-Петербургский институт точной механики и оптики."},
 {kind:"Вопрос об учёном",img:"lit",pos:"50% 50%",veil:1,
  q:"Кто стал главным конструктором «ЛИТМО-1» — первой отечественной электронно-цифровой машины, над которой работали в 1956–1959 годах?",
  o:["В.М. Арбузов","С.И. Вавилов","Н.Б. Завадский","Феодосий Галкин"],a:3,
  cap:"«ЛИТМО-1» — первая отечественная электронно-цифровая машина",
  e:"«ЛИТМО-1» разработали в Ленинградском институте точной механики и оптики. Работы над машиной начались в 1956 году и завершились в 1959-м. Главным конструктором стал доцент Феодосий Галкин."}
];
var $=function(id){return document.getElementById(id)};
var i=0,right=0,log=[],layer=0;
function setBg(k){var a=$("bgA"),b=$("bgB"),on=layer?b:a,off=layer?a:b;layer=1-layer;
  off.style.backgroundImage="url("+IM[k]+")";off.classList.add("on");on.classList.remove("on");}
function plate(k,pos,veil,cap){
  var p=$("plate");
  p.className="plate reset "+(veil?"veiled live":"live");
  $("pcap").textContent="";
  $("pimg").src=IM[k];$("pimg").style.objectPosition=pos||"50% 50%";
  $("veil").classList.toggle("hide",!veil);
  void p.offsetWidth;
  requestAnimationFrame(function(){requestAnimationFrame(function(){p.classList.remove("reset");});});
}
function steps(n){var h="";for(var s=0;s<Q.length;s++)h+='<i class="'+(s<n?"done":"")+'"></i>';return '<div class="steps">'+h+'</div>';}
function start(){
  setBg("uch");plate("uch","50% 50%",0,"Ремесленное училище цесаревича Николая, 1-я Рота Измайловского полка. Основано в 1875 году");
  setTimeout(function(){$("pcap").textContent="Ремесленное училище цесаревича Николая, 1-я Рота Измайловского полка. Основано в 1875 году";$("plate").className="plate clear";},60);
  $("sheet").innerHTML='<h1>Как Ремесленное училище стало университетом</h1><p class="lead">Пять вопросов по видеолекции об истории ИТМО: три об учёных и два по фотографиям со слайдов. После каждого ответа — пояснение с фактами.</p><div class="row" style="justify-content:flex-start"><button class="btn" id="go">Начать квиз</button></div><p class="tip">С клавиатуры: цифры 1–4 выбирают ответ, Enter — дальше.</p>';
  $("go").onclick=function(){i=0;right=0;log=[];ask();};
}
function ask(){
  var d=Q[i];setBg(d.img);plate(d.img,d.pos,d.veil,d.cap);
  var h=steps(i)+'<p class="kind">'+d.kind+'</p><h2></h2><ul class="opts"></ul><div id="why"></div><div class="row"><button class="btn hide" id="next"></button></div>';
  $("sheet").innerHTML=h;$("sheet").querySelector("h2").textContent=d.q;
  var ul=$("sheet").querySelector(".opts");
  d.o.forEach(function(t,k){var li=document.createElement("li"),b=document.createElement("button");
    b.className="opt";b.type="button";b.textContent=t;b.onclick=function(){pick(k)};
    b.onpointermove=function(e){var r=b.getBoundingClientRect();b.style.setProperty("--mx",(e.clientX-r.left)+"px");b.style.setProperty("--my",(e.clientY-r.top)+"px");};
    li.appendChild(b);ul.appendChild(li);});
  $("next").onclick=function(){if(i<Q.length-1){i++;ask();}else end();};
}
function pick(k){
  var d=Q[i],ok=k===d.a;
  document.querySelectorAll(".opt").forEach(function(b,n){b.disabled=true;
    b.classList.add(n===d.a?"ok":n===k?"bad":"dim");});
  if(ok)right++;log.push(ok);
  var w=$("why");w.className="why "+(ok?"good":"nope");
  w.innerHTML="<strong></strong><span></span>";
  w.firstChild.textContent=ok?"Верно":"Правильный ответ — "+d.o[d.a];
  w.lastChild.textContent=d.e;
  $("pcap").textContent=d.cap;$("plate").className="plate clear";
  document.querySelectorAll(".steps i")[i].classList.add("done");
  var n=$("next");n.textContent=i===Q.length-1?"Показать результат":"Дальше";n.classList.remove("hide");n.focus({preventScroll:true});
}
function end(){
  setBg("uch");plate("uch","50% 50%",0,"");setTimeout(function(){$("plate").className="plate clear";},60);
  var tv=right===5?"Без единой ошибки.":right>=3?"Уверенный результат.":"Стоит пересмотреть лекцию.";
  var s='<p class="kind">Ваш результат</p><div class="score">'+right+'<small>из '+Q.length+'</small></div><p class="lead" style="margin-bottom:22px">'+tv+'</p><div class="strip">';
  Q.forEach(function(d,n){s+='<figure class="'+(log[n]?"y":"n")+'"><div><img alt="" src="'+IM[d.img]+'"></div><figcaption></figcaption></figure>';});
  s+='</div><div class="row" style="justify-content:flex-start;margin-top:0"><button class="btn" id="again">Пройти ещё раз</button></div>';
  $("sheet").innerHTML=s;
  document.querySelectorAll(".strip figcaption").forEach(function(c,n){c.textContent=Q[n].o[Q[n].a];});
  $("again").onclick=function(){i=0;right=0;log=[];ask();};
  var sc=document.querySelector(".score"),tn=sc.firstChild,c=0;tn.nodeValue="0";
  (function tick(){if(c<right){c++;tn.nodeValue=String(c);setTimeout(tick,170);}})();
}
new MutationObserver(function(){var s=$("sheet");s.classList.remove("fresh");void s.offsetWidth;s.classList.add("fresh");}).observe($("sheet"),{childList:true});
document.addEventListener("keydown",function(e){var n=parseInt(e.key,10);
  if(n>=1&&n<=4){var b=document.querySelectorAll(".opt")[n-1];if(b&&!b.disabled)b.click();}
  else if(e.key==="Enter"){var g=$("go");if(g&&document.activeElement!==g)g.click();}});
for(var k in IM){var im=new Image();im.src=IM[k];}
start();
</script>
</body>
</html>
